<Project Sdk="Microsoft.NET.Sdk">

	<!-- Do not import ProjectBuildProperties.targets: it holds the package (nuspec/version) settings, and test projects are not packed. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>TqkLibrary.Asp.ToolKit.Caching.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="coverlet.collector" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\TqkLibrary.Asp.ToolKit.Caching\TqkLibrary.Asp.ToolKit.Caching.csproj" />
	</ItemGroup>

</Project>
