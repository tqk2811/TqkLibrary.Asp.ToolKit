<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<!--https://docs.microsoft.com/en-us/nuget/reference/nuspec-->
	<metadata>
		<id>$id$</id>
		<version>$version$</version>
		<description>ASP.NET Core web (BFF) authentication against a separate JWT API: API access/refresh tokens kept only in the encrypted auth cookie, a DelegatingHandler that attaches the bearer and refreshes it, a middleware that builds the current user from the API, and session-expiry handling.</description>
		<authors>tqk2811</authors>
		<projectUrl>https://github.com/tqk2811/TqkLibrary.Asp.ToolKit</projectUrl>
		<repository type="git" url="https://github.com/tqk2811/TqkLibrary.Asp.ToolKit.git"/>
		<license type="expression">MIT</license>
		<readme>docs\README.md</readme>
		<frameworkReferences>
			<group targetFramework="net10.0">
				<frameworkReference name="Microsoft.AspNetCore.App"/>
			</group>
		</frameworkReferences>
		<dependencies>
			<group targetFramework="net10.0">
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="README.md" target="docs\" />
		<file src="bin\Release\net10.0\TqkLibrary.Asp.ToolKit.Auth.Web.dll" target="lib\net10.0\" />
		<file src="bin\Release\net10.0\TqkLibrary.Asp.ToolKit.Auth.Web.pdb" target="lib\net10.0\" />
		<file src="bin\Release\net10.0\TqkLibrary.Asp.ToolKit.Auth.Web.xml" target="lib\net10.0\" />
	</files>
</package>
