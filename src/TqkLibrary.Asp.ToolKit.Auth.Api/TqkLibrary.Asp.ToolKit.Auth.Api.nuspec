<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<!--https://docs.microsoft.com/en-us/nuget/reference/nuspec-->
	<metadata>
		<id>$id$</id>
		<version>$version$</version>
		<description>ASP.NET Core API authentication with opaque, non-rotating session tokens ({sessionId}.{secret}, only the SHA-256 of the secret is stored): an authentication handler that checks the session on every request through a short in-memory cache, and a throttled sliding expiry with an absolute cap.</description>
		<authors>tqk2811</authors>
		<projectUrl>https://github.com/tqk2811/TqkLibrary.Asp.ToolKit</projectUrl>
		<repository type="git" url="https://github.com/tqk2811/TqkLibrary.Asp.ToolKit.git"/>
		<license type="expression">MIT</license>
		<readme>docs\README.md</readme>
		<frameworkReferences>
			<group targetFramework="net10.0">
				<frameworkReference name="Microsoft.AspNetCore.App"/>
			</group>
		</frameworkReferences>
		<dependencies>
			<group targetFramework="net10.0">
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="README.md" target="docs\" />
		<file src="bin\Release\net10.0\TqkLibrary.Asp.ToolKit.Auth.Api.dll" target="lib\net10.0\" />
		<file src="bin\Release\net10.0\TqkLibrary.Asp.ToolKit.Auth.Api.pdb" target="lib\net10.0\" />
		<file src="bin\Release\net10.0\TqkLibrary.Asp.ToolKit.Auth.Api.xml" target="lib\net10.0\" />
	</files>
</package>
