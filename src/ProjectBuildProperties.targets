<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--<PreserveCompilationContext>false</PreserveCompilationContext>-->
		<!--<GenerateDependencyFile>false</GenerateDependencyFile>-->
		<!--<ProduceReferenceAssembly>false</ProduceReferenceAssembly>-->
		<!-- Emit XML doc for IntelliSense; CS1591 = missing doc comment on a public member -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<!-- Embed all source files into the portable PDB so step-into works offline -->
		<EmbedAllSources>true</EmbedAllSources>
	</PropertyGroup>

	<!--
		Version: each packable project sets its own <VersionPrefix>M.N.P</VersionPrefix> in its csproj, bumped in the
		commit that changes that package. The release workflow builds with -p:TqkRelease=true and gets exactly M.N.P
		(it pushes only the versions nuget.org does not have yet). Any other build gets M.N.P-dev, so a locally packed
		package never collides with a published one.
		The csproj body is evaluated after this file, so only VersionSuffix is set here; the SDK combines it with the
		project's VersionPrefix later.
	-->
	<PropertyGroup Condition="'$(TqkRelease)' != 'true' And '$(VersionSuffix)' == ''">
		<VersionSuffix>dev</VersionSuffix>
	</PropertyGroup>

	<!-- NuSpec support for dotnet pack -->
	<PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).nuspec')">
		<NuspecFile>$(MSBuildProjectName).nuspec</NuspecFile>
		<TqkPackable>true</TqkPackable>
	</PropertyGroup>

	<!-- AssemblyVersion = Major.Minor.0.0 (patch releases need no binding redirect); FileVersion = M.N.P.0.
	     Runs as a target because VersionPrefix comes from the csproj body, after this file is evaluated. -->
	<Target Name="TqkSetVersion" BeforeTargets="GetAssemblyVersion;GenerateNuspec" Condition="'$(TqkPackable)' == 'true'">
		<PropertyGroup>
			<AssemblyVersion>$([System.Version]::Parse('$(VersionPrefix)').Major).$([System.Version]::Parse('$(VersionPrefix)').Minor).0.0</AssemblyVersion>
			<FileVersion>$(VersionPrefix).0</FileVersion>
			<NuspecProperties>id=$(MSBuildProjectName);version=$(PackageVersion)</NuspecProperties>
		</PropertyGroup>
	</Target>

	<!-- Returns the version this project packs as (used by release.yml and by packages whose nuspec depends on another package) -->
	<Target Name="TqkGetPackageVersion" Returns="$(PackageVersion)" />

</Project>
